# Salin ke .env untuk pengembangan lokal.  .env sudah masuk .gitignore.
# Produksi mengambil nilai-nilai ini dari environment atau secret manager.

FLEETVIEW_ENVIRONMENT=development
FLEETVIEW_LOG_LEVEL=INFO
FLEETVIEW_LOG_FORMAT=console

# ---- Central API ----
FLEETVIEW_HOST=0.0.0.0
FLEETVIEW_PORT=8000
FLEETVIEW_POSTGRES_DSN=postgresql+asyncpg://fleetview:fleetview@localhost:5432/fleetview
FLEETVIEW_INFLUX_URL=http://localhost:8086
FLEETVIEW_INFLUX_ORG=fleetview
FLEETVIEW_INFLUX_BUCKET=telemetry
FLEETVIEW_INFLUX_TOKEN=fleetview-dev-token

# Minimal 32 karakter di produksi. Nilai di bawah hanya untuk dev.
FLEETVIEW_JWT_SECRET=dev-only-secret-ganti-di-produksi-xxxx
FLEETVIEW_JWT_TTL_SECONDS=3600

# Kunci enkripsi untuk menyimpan rahasia kredensial kapal, supaya skrip pasang
# bisa diunduh ulang dari dashboard dengan kredensial yang sama. Nilai di bawah
# hanya untuk dev. Di produksi buat sendiri: openssl rand -base64 32 | tr '+/' '-_'
# dan simpan cadangannya terpisah; kunci yang hilang membuat kredensial tersimpan
# tidak terbaca (kapal tetap bisa login, hanya skripnya tidak bisa dibuka lagi).
FLEETVIEW_CREDENTIAL_KEY=hYPwNczWuIcHtbvCpvOcAFnGjaGAVyL9npx2tjZA24M=
FLEETVIEW_CORS_ORIGINS=["http://localhost:5173"]

# Halaman Kesehatan Sistem memeriksa disk partisi yang memuat path ini.
# Opsional; nilai di bawah adalah defaultnya. "kritis" membuat status degraded.
# FLEETVIEW_HEALTH_DISK_PATH=/
# FLEETVIEW_DISK_WARN_PERCENT=80
# FLEETVIEW_DISK_CRITICAL_PERCENT=90

# ---- Edge Agent ----
# Identitas kapal biasanya diisi lewat berkas config, bukan env.
# Lihat edge/agent/config/edge.example.yaml
FLEETVIEW_EDGE_CONFIG=edge/agent/config/edge.example.yaml
