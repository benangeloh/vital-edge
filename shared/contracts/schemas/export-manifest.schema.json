{
  "$defs": {
    "ExportedBatch": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "format": "uuid",
          "title": "Batch Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "payload_checksum": {
          "title": "Payload Checksum",
          "type": "string"
        },
        "payload_size": {
          "exclusiveMinimum": 0,
          "title": "Payload Size",
          "type": "integer"
        },
        "record_count": {
          "exclusiveMinimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "sequence_end": {
          "minimum": 0,
          "title": "Sequence End",
          "type": "integer"
        },
        "sequence_start": {
          "minimum": 0,
          "title": "Sequence Start",
          "type": "integer"
        }
      },
      "required": [
        "batch_id",
        "filename",
        "sequence_start",
        "sequence_end",
        "record_count",
        "payload_checksum",
        "payload_size"
      ],
      "title": "ExportedBatch",
      "type": "object"
    }
  },
  "$id": "https://fleetview.spil.co.id/schemas/1.0/export-manifest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Ditulis di akar folder export. Diverifikasi tool usb-import sebelum ingest.",
  "properties": {
    "agent_version": {
      "title": "Agent Version",
      "type": "string"
    },
    "batches": {
      "items": {
        "$ref": "#/$defs/ExportedBatch"
      },
      "minItems": 1,
      "title": "Batches",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "device_id": {
      "format": "uuid",
      "title": "Device Id",
      "type": "string"
    },
    "export_checksum": {
      "title": "Export Checksum",
      "type": "string"
    },
    "export_id": {
      "format": "uuid",
      "title": "Export Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "ship_id": {
      "format": "uuid",
      "title": "Ship Id",
      "type": "string"
    }
  },
  "required": [
    "export_id",
    "ship_id",
    "device_id",
    "created_at",
    "agent_version",
    "schema_version",
    "batches",
    "export_checksum"
  ],
  "title": "ExportManifest",
  "type": "object"
}
