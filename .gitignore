*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Node
node_modules/
dist/
.vite/

# Env & secrets — jangan pernah di-commit
.env
.env.*

# Data kapal simulasi saat menjalankan di komputer sendiri
# (docs/operations/00-menjalankan.md bagian A)
.devdata/
!.env.example
*.pem
*.key
# Runbook operasional IKUT masuk repo: install.sh menyalinnya ke perangkat, dan
# kapal tidak punya internet — panduan troubleshooting justru paling dibutuhkan
# di tempat ia tidak bisa diunduh.
#
# Yang dikecualikan hanya manual PDF vendor (2,8 MB, bukan hasil kerja kita).
docs/**/*.pdf

# Data runtime edge
*.db
*.db-wal
*.db-shm
/data/
/var/

# OS / editor
.DS_Store
.idea/
.vscode/
