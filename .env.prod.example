# Salin ke `.env` di direktori yang sama dengan docker-compose.prod.yml (di
# root repo) — variabel di sini dipakai Docker Compose sendiri untuk
# interpolasi ${VAR} di file YAML, BUKAN untuk konfigurasi aplikasi (itu tetap
# di /etc/fleetview/central.env dan secrets.env, terpisah, tidak berubah).

COMPOSE_PROJECT_NAME=fleetview-central

FLEETVIEW_DATA_DIR=/var/lib/fleetview

POSTGRES_USER=fleetview
POSTGRES_DB=fleetview

INFLUXDB_INIT_ORG=fleetview
INFLUXDB_INIT_BUCKET=telemetry
INFLUXDB_INIT_RETENTION=365d

FLEETVIEW_IMAGE_TAG=local
